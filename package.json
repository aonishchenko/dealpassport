{
  "name": "dealpassport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Issuer-bound private deal qualification on Stellar Testnet",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:contracts": "sh scripts/build-contracts.sh",
    "setup:circuit": "node scripts/setup-circuit.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:testnet:baseline": "node scripts/gate-a.mjs",
    "verify:testnet:eligibility": "node scripts/gate-b.mjs",
    "build": "tsc --noEmit && vite build",
    "dev": "wrangler dev --port 8973 --inspector-port 9238",
    "deploy": "npm run build && wrangler deploy",
    "verify:testnet:mutual": "node scripts/gate-c.mjs",
    "verify:api": "node scripts/gate-d.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@stellar/stellar-sdk": "17.4.0",
    "circomlibjs": "0.1.7",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "underscore": "^1.13.8",
    "undici": "^7.30.1"
  },
  "license": "SEE LICENSE IN LICENSE"
}
