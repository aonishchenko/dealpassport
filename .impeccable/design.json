  "narrative": {
    "northStar": "The Quiet Deal Ledger",
    "overview": "Deal Passport presents a private introduction as a calm, legible sequence of qualifications and choices. Warm paper, stone surfaces, olive typography and fine rules give the workflow the character of a carefully maintained deal ledger. Lora headings lend an editorial voice; Inter carries the compact operational detail.\n\nThe visual identity is already established. This document records the implementation in src/App.tsx and src/styles.css; Deal_Passport_HackMeridian_Build_Spec.md remains the canonical product specification. State, synthetic-data disclosure and inspectable evidence shape the interface without turning technical detail into decoration.",
    "keyCharacteristics": [
      "Warm light surfaces and restrained olive emphasis.",
      "Square controls, fine rules and flat tonal depth.",
      "Serif headings paired with compact sans-serif operational text.",
      "Visible qualification, consent and disclosure state."
    ],
    "rules": [
      {
        "name": "The State Before Decoration Rule",
        "body": "Use color, labels and icons to explain qualification or consent; never imply a verified state through decoration alone.",
        "section": "colors"
      },
      {
        "name": "The Flat Ledger Rule",
        "body": "Separate content with spacing, fine rules and stone surfaces. Keep the implemented interface free of shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the approved paper, stone, ink and olive palette with Inter and Lora.",
      "Do show requirements individually and pair state color with words or icons.",
      "Do keep keyboard focus visible and honor reduced-motion preferences.",
      "Do retain the difference between qualification, consent and actual disclosure.",
      "Do keep technical identifiers breakable and public receipt links inspectable."
    ],
    "donts": [
      "Don't introduce rounded cards, gradients or drop shadows into this flat system.",
      "Don't use color alone to communicate verification, failure or privacy.",
      "Don't add photography, logos or borrowed identity assets without an explicit brief.",
      "Don't replace the canonical product specification with a generated product document."
    ]
  }
