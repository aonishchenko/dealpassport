{
  "name": "dealpassport-demo-video",
  "version": "1.0.0",
  "description": "Remotion composition for the Deal Passport product demo",
  "repository": {
    "type": "git",
    "url": "https://github.com/aonishchenko/dealpassport.git",
    "directory": "video"
  },
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.74.0",
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/media": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "narrate": "node --env-file=../.env generate-voiceover.mjs",
    "prepare": "node prepare-video.mjs",
    "render": "remotion render src/index.ts DealPassportDemo ../output/demo/Deal_Passport_Demo_Remotion_raw.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=4",
    "finalize": "node finalize-audio.mjs",
    "check": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild": false
  }
}
